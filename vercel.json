{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/news-sitemap.xml", "destination": "/api/news-sitemap.xml" },
    { "source": "/rss.xml", "destination": "/api/rss.xml" },
    { "source": "/noticia/:id", "destination": "/api/noticia-premium?id=:id" },
    { "source": "/metodologia", "destination": "/metodologia.html" },
    { "source": "/redacao", "destination": "/redacao.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
